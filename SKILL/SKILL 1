    {
      "cell_type": "code",
      "source": [
        "def predict_image(image):\n",
        "\n",
        "    processed_image = preprocess_image(image)\n",
        "\n",
        "    predictions = model.predict(\n",
        "        processed_image,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    results = decode_predictions(\n",
        "        predictions,\n",
        "        top=5\n",
        "    )[0]\n",
        "\n",
        "    return results\n",
        "\n",
        "print(\"Prediction engine ready!\")\n",
        "\n"
      ],
